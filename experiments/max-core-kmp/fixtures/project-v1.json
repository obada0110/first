{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MAX EDITOR Project Contract v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "enum": [
        1
      ]
    },
    "projectId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "canvas": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 64,
          "maximum": 3840
        },
        "height": {
          "type": "integer",
          "minimum": 64,
          "maximum": 3840
        },
        "background": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^#[a-fA-F0-9]{6}$"
            },
            {
              "enum": [
                "transparent"
              ]
            }
          ]
        }
      },
      "required": [
        "width",
        "height",
        "background"
      ],
      "additionalProperties": false
    },
    "fps": {
      "$ref": "#/$defs/fps"
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      },
      "minItems": 1
    },
    "mainTrack": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "clips": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/clip"
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "clips"
      ],
      "additionalProperties": false
    },
    "layers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/layer"
      },
      "minItems": 0
    }
  },
  "required": [
    "schemaVersion",
    "projectId",
    "revision",
    "name",
    "canvas",
    "fps",
    "assets",
    "mainTrack",
    "layers"
  ],
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
    },
    "us": {
      "type": "integer",
      "minimum": 0,
      "maximum": 86400000000
    },
    "color": {
      "type": "string",
      "pattern": "^#[a-fA-F0-9]{6}$"
    },
    "pose": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "minimum": -50,
          "maximum": 150
        },
        "y": {
          "type": "number",
          "minimum": -50,
          "maximum": 150
        },
        "w": {
          "type": "number",
          "minimum": 5,
          "maximum": 300
        },
        "h": {
          "type": "number",
          "minimum": 5,
          "maximum": 300
        },
        "angle": {
          "type": "number",
          "minimum": -360,
          "maximum": 360
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "cropX": {
          "type": "number",
          "minimum": 0,
          "maximum": 95
        },
        "cropY": {
          "type": "number",
          "minimum": 0,
          "maximum": 95
        }
      },
      "required": [
        "x",
        "y",
        "w",
        "h",
        "angle",
        "opacity",
        "cropX",
        "cropY"
      ],
      "additionalProperties": false
    },
    "transform": {
      "type": "object",
      "properties": {
        "base": {
          "$ref": "#/$defs/pose"
        },
        "keys": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "atUs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 86400000000
              },
              "value": {
                "$ref": "#/$defs/pose"
              }
            },
            "required": [
              "atUs",
              "value"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        }
      },
      "required": [
        "base",
        "keys"
      ],
      "additionalProperties": false
    },
    "effects": {
      "type": "object",
      "properties": {
        "key": {
          "type": "object",
          "properties": {
            "keyColor": {
              "$ref": "#/$defs/color"
            },
            "back": {
              "$ref": "#/$defs/color"
            },
            "threshold": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "feather": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "despill": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "invert": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "keyColor",
            "back",
            "threshold",
            "feather",
            "despill",
            "invert"
          ],
          "additionalProperties": false
        },
        "blur": {
          "type": "object",
          "properties": {
            "radius": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "area": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "cx": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "cy": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          },
          "required": [
            "radius",
            "area",
            "cx",
            "cy"
          ],
          "additionalProperties": false
        },
        "glow": {
          "type": "object",
          "properties": {
            "amount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "size": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "gate": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "glowColor": {
              "$ref": "#/$defs/color"
            }
          },
          "required": [
            "amount",
            "size",
            "gate",
            "glowColor"
          ],
          "additionalProperties": false
        },
        "rain": {
          "type": "object",
          "properties": {
            "rainAmt": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "speed": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "wind": {
              "type": "integer",
              "minimum": -100,
              "maximum": 100
            },
            "rainMix": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          },
          "required": [
            "rainAmt",
            "speed",
            "wind",
            "rainMix"
          ],
          "additionalProperties": false
        },
        "frost": {
          "type": "object",
          "properties": {
            "ice": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "edge": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "grain": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "iceColor": {
              "$ref": "#/$defs/color"
            }
          },
          "required": [
            "ice",
            "edge",
            "grain",
            "iceColor"
          ],
          "additionalProperties": false
        },
        "motion": {
          "type": "object",
          "properties": {
            "distance": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "angle": {
              "type": "integer",
              "minimum": 0,
              "maximum": 180
            },
            "blend": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          },
          "required": [
            "distance",
            "angle",
            "blend"
          ],
          "additionalProperties": false
        },
        "light": {
          "type": "object",
          "properties": {
            "exposure": {
              "type": "integer",
              "minimum": -30,
              "maximum": 30
            },
            "gamma": {
              "type": "integer",
              "minimum": -80,
              "maximum": 80
            },
            "offset": {
              "type": "integer",
              "minimum": -100,
              "maximum": 100
            }
          },
          "required": [
            "exposure",
            "gamma",
            "offset"
          ],
          "additionalProperties": false
        },
        "contrast": {
          "type": "object",
          "properties": {
            "contrastAmt": {
              "type": "integer",
              "minimum": -100,
              "maximum": 100
            },
            "pivot": {
              "type": "integer",
              "minimum": 5,
              "maximum": 95
            }
          },
          "required": [
            "contrastAmt",
            "pivot"
          ],
          "additionalProperties": false
        },
        "sat": {
          "type": "object",
          "properties": {
            "saturation": {
              "type": "integer",
              "minimum": -100,
              "maximum": 100
            },
            "vibrance": {
              "type": "integer",
              "minimum": -100,
              "maximum": 100
            }
          },
          "required": [
            "saturation",
            "vibrance"
          ],
          "additionalProperties": false
        },
        "temp": {
          "type": "object",
          "properties": {
            "temperature": {
              "type": "integer",
              "minimum": -100,
              "maximum": 100
            },
            "tint": {
              "type": "integer",
              "minimum": -100,
              "maximum": 100
            }
          },
          "required": [
            "temperature",
            "tint"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "clip": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "assetId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "inUs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400000000
        },
        "outUs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000000
        },
        "transform": {
          "$ref": "#/$defs/transform"
        },
        "effects": {
          "$ref": "#/$defs/effects"
        }
      },
      "required": [
        "id",
        "assetId",
        "inUs",
        "outUs",
        "transform",
        "effects"
      ],
      "additionalProperties": false
    },
    "layer": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            "startUs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 86400000000
            },
            "durationUs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400000000
            },
            "transform": {
              "$ref": "#/$defs/transform"
            },
            "kind": {
              "enum": [
                "overlay"
              ]
            },
            "assetId": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            }
          },
          "required": [
            "id",
            "startUs",
            "durationUs",
            "transform",
            "kind",
            "assetId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            "startUs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 86400000000
            },
            "durationUs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400000000
            },
            "transform": {
              "$ref": "#/$defs/transform"
            },
            "kind": {
              "enum": [
                "text"
              ]
            },
            "text": {
              "type": "string",
              "maxLength": 400
            },
            "font": {
              "enum": [
                "sans",
                "bold",
                "serif"
              ]
            },
            "color": {
              "type": "string",
              "pattern": "^#[a-fA-F0-9]{6}$"
            },
            "effect": {
              "enum": [
                "none",
                "outline",
                "shadow"
              ]
            }
          },
          "required": [
            "id",
            "startUs",
            "durationUs",
            "transform",
            "kind",
            "text",
            "font",
            "color",
            "effect"
          ],
          "additionalProperties": false
        }
      ]
    },
    "asset": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "kind": {
          "enum": [
            "video",
            "image"
          ]
        },
        "durationUs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400000000
        }
      },
      "required": [
        "id",
        "kind",
        "durationUs"
      ],
      "additionalProperties": false
    },
    "fps": {
      "enum": [
        {
          "num": 24,
          "den": 1
        },
        {
          "num": 30,
          "den": 1
        },
        {
          "num": 60,
          "den": 1
        },
        {
          "num": 24000,
          "den": 1001
        },
        {
          "num": 30000,
          "den": 1001
        },
        {
          "num": 60000,
          "den": 1001
        }
      ]
    }
  }
}
